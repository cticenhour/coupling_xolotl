Get the coupling code and update it:
```
git clone https://github.com/SciDAC-MOOSE-Xolotl-coupling-group/coupling_xolotl.git coupling_xolotl
cd coupling_xolotl
git submodule init
git submodule update
cd moose
git checkout devel
cd ../xolotl
git checkout stable
git apply hypre.patch
```
with `hypre.patch`:
```
diff --git a/CMake/BuildPETSc.cmake b/CMake/BuildPETSc.cmake
index ad4f75c5..d8511e51 100644
--- a/CMake/BuildPETSc.cmake
+++ b/CMake/BuildPETSc.cmake
@@ -43,6 +43,8 @@ option(Xolotl_BUILD_LAPACK "Have the PETSc build system build LAPACK" OFF)
